# Paths are resolved by run.sh. Keep every OpenNeuro dataset read-only.
# Immediate child directories must use the OpenNeuro dsXXXXXX identifier format.
DATASET_ROOT="${PROJECT_ROOT}/datasets/openneuro"
OUTPUT_ROOT="${PROJECT_ROOT}/pipelines/fsl_openneuro/output"

# Rolling worker pool. Four workers is a conservative default for a 32 GB VM.
DEFAULT_JOBS=4
THREADS_PER_WORKER=1

# Initial dataset selection. Override TASK/RUN with run.sh flags.
SUBJECT="sub-01"
SESSION="ses-localizer1"
DEFAULT_TASK="6cat"
DEFAULT_RUN="01"

# Whole-head T1 used for BET, BBR, and FNIRT.
T1W_RELATIVE_PATH="sub-01/ses-localizer1/anat/sub-01_ses-localizer1_acq-prescannormalized_rec-pydeface_T1w.nii.gz"

# Pre-processing parameters.
DELETE_VOLUMES=0
SMOOTH_FWHM_MM=6
HIGHPASS_HZ=0.01
BET_FRACTIONAL_INTENSITY=0.5
BET_VERTICAL_GRADIENT=0.0
FNIRT_WARP_RESOLUTION_MM=10

# FEAT may submit local jobs and return before they finish.
MAX_WAIT_HOURS=12
