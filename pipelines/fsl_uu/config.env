# Paths are resolved by run.sh. The UU source archives remain read-only.
DATASET_ROOT="${PROJECT_ROOT}/datasets/uu"
OUTPUT_ROOT="${PROJECT_ROOT}/pipelines/fsl_uu/output"

# Rolling worker pool. Four workers is a conservative default for a 32 GB VM.
DEFAULT_JOBS=4
THREADS_PER_WORKER=1

# Professor-specified preprocessing parameters.
DELETE_VOLUMES=0
SMOOTH_FWHM_MM=6
HIGHPASS_HZ=0.01
BET_FRACTIONAL_INTENSITY=0.5
BET_VERTICAL_GRADIENT=0.0
FNIRT_WARP_RESOLUTION_MM=10

# The source JSON files do not contain SliceTiming. "none" is the safe
# default: FEAT will not perform slice-timing correction. Change this only
# after the acquisition order has been confirmed by UU/the scanner protocol.
# Allowed values: none, regular-up, regular-down, interleaved, metadata, custom
SLICE_TIMING_MODE="none"

# Used only when SLICE_TIMING_MODE="custom". The file must contain one
# fractional-TR timing shift per slice (each value between -0.5 and 0.5).
# A relative path is resolved from the pipelines/fsl_uu directory.
CUSTOM_SLICE_TIMING_FILE=""

# FEAT may submit local jobs and return before they finish.
MAX_WAIT_HOURS=12
